# URL base de signa-api. NO lleva /api: application.yaml no define context-path,
# las rutas del back son directas (/auth/..., /users/...).
# Produccion: http://161.35.105.45 (puerto 80, detras de proxy).
# Desarrollo local:
#   Android emulator: usar http://10.0.2.2:8080 en vez de localhost.
#   iOS simulator: http://localhost:8080 funciona directo.
#   Dispositivo fisico: usar la IP de tu PC en la red local (ej http://192.168.0.10:8080).
EXPO_PUBLIC_API_URL=http://161.35.105.45

# PoC de animaciones 3D: meaning de la Sign con animationUrl="lsa/test.glb".
# El backend crea la seña "test" al arrancar con perfil local (TestSignSeeder). Editable en la pantalla.
EXPO_PUBLIC_TEST_SIGN_MEANING=test