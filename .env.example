# URL base de signa-api. NO lleva /api: application.yaml no define context-path,
# las rutas del back son directas (/auth/..., /users/...).
# Produccion: https://api.signasource.app (HTTPS via Cloudflare; Android bloquea HTTP plano en builds release).
# Desarrollo local:
#   Android emulator: usar http://10.0.2.2:8080 en vez de localhost.
#   iOS simulator: http://localhost:8080 funciona directo.
#   Dispositivo fisico: usar la IP de tu PC en la red local (ej http://192.168.0.10:8080).
EXPO_PUBLIC_API_URL=https://api.signasource.app

# Client ID de Google tipo "Web application". Debe ser el MISMO valor que GOOGLE_CLIENT_ID en signa-api
# (el back valida que el idToken tenga ese audience). Ademas hace falta un client ID tipo "Android"
# en el mismo proyecto de Google Cloud con el package com.signasource.signamobile y el SHA-1 del keystore.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=