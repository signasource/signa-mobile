{
  "expo": {
    "name": "Signa",
    "slug": "signa-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "backgroundColor": "#1D283C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signasource.signamobile"
    },
    "android": {
      "package": "com.signasource.signamobile",
      "adaptiveIcon": {
        "backgroundColor": "#1D283C"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "34f4fd85-6919-4015-928e-6427f234c7cc"
      }
    }
  }
}
