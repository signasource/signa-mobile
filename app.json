{
  "expo": {
    "name": "Signa",
    "slug": "signa-mobile",
    "scheme": "signa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "backgroundColor": "#1D283C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signasource.signamobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Signa usa la cámara para reconocer las señas que hacés durante los ejercicios. El video se procesa para evaluar la seña y no se guarda."
      }
    },
    "android": {
      "package": "com.signasource.signamobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F7F7"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Signa usa la cámara para reconocer las señas que hacés durante los ejercicios.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Signa accede a tus fotos solo para que elijas tu foto de perfil.",
          "cameraPermission": "Signa usa la cámara para reconocer señas y para sacarte una foto de perfil si lo elegís.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REEMPLAZAR-POR-CLIENT-ID-IOS"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "34f4fd85-6919-4015-928e-6427f234c7cc"
      }
    }
  }
}
