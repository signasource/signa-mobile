{
  "expo": {
    "name": "Signa",
    "slug": "signa-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.jpg",
    "splash": {
      "backgroundColor": "#1D283C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signasource.signamobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Signa usa la cámara para reconocer las señas que hacés durante los ejercicios. El video se procesa para evaluar la seña y no se guarda."
      }
    },
    "android": {
      "package": "com.signasource.signamobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#1D283C"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Signa usa la cámara para reconocer las señas que hacés durante los ejercicios.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "34f4fd85-6919-4015-928e-6427f234c7cc"
      }
    }
  }
}
